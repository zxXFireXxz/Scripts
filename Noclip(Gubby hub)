OrbStroke.Thickness = 2

local noclip = false
local player = game:GetService("Players").LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local TweenService = game:GetService("TweenService")

player.CharacterAdded:Connect(function(char)
    character = char
end)

local function resetCollision()
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "HumanoidRootPart" or part.Name == "Head" or string.find(part.Name, "Arm") or part.Name == "Torso" then

                part.CanCollide = true
                end
            end
        end
    end
end

CloseButton.MouseButton1Click:Connect(function()
    noclip = false
    resetCollision()
    ScreenGui:Destroy()
end)

MinimizeButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OrbButton.Visible = true
    OrbButton.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(OrbButton, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 45, 0, 45)}):Play()
end)

OrbButton.MouseButton1Click:Connect(function()
    OrbButton.Visible = false
    MainFrame.Visible = true
end)

CloseButton.MouseEnter:Connect(function() CloseButton.TextColor3 = Color3.fromRGB(255, 70, 70) end)
CloseButton.MouseLeave:Connect(function() CloseButton.TextColor3 = Color3.fromRGB(150, 150, 150) end)

MinimizeButton.MouseEnter:Connect(function() MinimizeButton.TextColor3 = Color3.fromRGB(0, 170, 255) end)
MinimizeButton.MouseLeave:Connect(function() MinimizeButton.TextColor3 = Color3.fromRGB(150, 150, 150) end)

OrbButton.MouseEnter:Connect(function() TweenService:Create(OrbStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 255, 255)}):Play() end)
OrbButton.MouseLeave:Connect(function() TweenService:Create(OrbStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 170, 255)}):Play() end)

ToggleButton.MouseButton1Click:Connect(function()
    noclip = not noclip
    if noclip then
        ToggleButton.Text = "Noclip: ON"
        ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 120)
        ButtonStroke.Color = Color3.fromRGB(0, 255, 120)
    else
        ToggleButton.Text = "Noclip: OFF"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        ButtonStroke.Color = Color3.fromRGB(50, 50, 50)
        resetCollision()
    end
end)

game:GetService("RunService").Stepped:Connect(function()
    if noclip and character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)
