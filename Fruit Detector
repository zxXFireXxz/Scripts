local function isIceFruit(fruit)
    local cubePart = fruit:FindFirstChild("Cube.008")
    if cubePart and cubePart:IsA("BasePart") then
        local targetColor = Color3.fromRGB(106, 57, 9)
        local partColor = cubePart.Color
        local tolerance = 0.01
        if math.abs(partColor.R - targetColor.R) < tolerance and
           math.abs(partColor.G - targetColor.G) < tolerance and
           math.abs(partColor.B - targetColor.B) < tolerance then
            return true
        end
    end
    return false
end

local function isDiamondFruit(fruit)
    local cubePart = fruit:FindFirstChild("Cube.002")
    if cubePart and cubePart:IsA("BasePart") then
        local targetColor = Color3.fromRGB(4, 175, 236)
        local partColor = cubePart.Color
        local tolerance = 0.01
        if math.abs(partColor.R - targetColor.R) < tolerance and
           math.abs(partColor.G - targetColor.G) < tolerance and
           math.abs(partColor.B - targetColor.B) < tolerance then
            return true
        end
    end
    return false
end

