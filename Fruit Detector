local animToFruit = {}
for fruitName, animId in pairs(fruitanims) do
    if animId ~= "" then
        animToFruit[animId] = fruitName
    end
end

local fruitNames = {}
for fruitName, _ in pairs(fruitanims) do
    table.insert(fruitNames, fruitName)
end

local fruitMeshIds = {
    Ice = "rbxassetid://15100433167",
    Diamond = "rbxassetid://15112600534",
}

local meshToFruit = {}
for fruitName, meshId in pairs(fruitMeshIds) do
    if meshId ~= "" then
        meshToFruit[meshId] = fruitName
    end
end

local function getFruitByMeshId(fruit)
    local fruitChild = fruit:FindFirstChild("Fruit")
    if not fruitChild then return nil end
    
    for _, child in ipairs(fruitChild:GetChildren()) do
        if child:IsA("BasePart") and child:IsA("MeshPart") then
            if child.MeshId and meshToFruit[child.MeshId] then
                return meshToFruit[child.MeshId]
            end
        end
    end
    return nil
end

local function isControlFruit(fruit)
    local fruitChild = fruit:FindFirstChild("Fruit")
    if fruitChild then
        local controlModel = fruitChild:FindFirstChild("ControlModel")
        if controlModel and controlModel:IsA("Model") then
            return true
        end
    end
    return false
end

