local plr = game:GetService("Players").LocalPlayer
local char = plr.Character
local RunService = game:GetService("RunService")
local hrp = char.HumanoidRootPart
local Library = loadstring(game:HttpGet( "https://raw.githubusercontent.com/tlredz/Library/refs/heads/main/redz-V5-remake/main.luau" ))()

--{Values}
local ChoosedSave = "Autosave"
local AutosaveEvent = game:GetService("ReplicatedStorage").ClientServerRemotes.LoadBuild
local AutoLoad = false
local AutoLoadconnection = nil
local Start = false
local MultiDifficulty = true
local WaveNumber = 1
local ChoosedWave
local ChoosedDifficulty = "Easy"
local AutoWave = false
local AutoWaveEvent = game:GetService("ReplicatedStorage").ClientServerRemotes.StartWave
local Autowaveconnection = nil

-- Control variables for rate limiting
local waveCooldown = false
local loadCooldown = false
local collectLoopRunning = false

--{Menu}

local Window = Library:MakeWindow({ Title = "BlueX2 : SoldierZ", SubTitle = "dev by zxXFireXxz", ScriptFolder = "BlueX2-soldierZ" })

local Minimizer = Window:NewMinimizer({ KeyCode = Enum.KeyCode.LeftControl })

local MobileButton = Minimizer:CreateMobileMinimizer({ Image = "rbxassetid://123239746308801", BackgroundColor3 = Color3.fromRGB(0, 0, 0) })

local MainTab = Window:MakeTab({ Title = "Cool Tab", Icon = "Dice" })

MainTab:AddTextBox({ Name = "Choose Wave", Placeholder = "1-40", ClearOnFocus = true, Callback = function(Value)
    WaveNumber = tonumber(Value) or 1
end
})

MainTab:AddDropdown({ Name = "Choose Difficulty", Options = {"Easy", "Medium", "Hard", "ToyBreaker"}, Default = "Easy", Callback = function(Value)
    ChoosedDifficulty = Value
end
})

MainTab:AddToggle({ Name = "Start auto wave", Default = false, Callback = function(State)
    AutoWave = State
    
    if AutoWave == true then
        if not Autowaveconnection then
            Autowaveconnection = RunService.Heartbeat:Connect(function()
                if AutoWave and WaveNumber and ChoosedDifficulty then
                    if not waveCooldown then
                        waveCooldown = true
                        AutoWaveEvent:FireServer(WaveNumber, ChoosedDifficulty, Start)
                        task.wait(2) -- 2 second delay between waves
                        waveCooldown = false
                    end
                end
            end)
        end
    else
        if Autowaveconnection then
            Autowaveconnection:Disconnect()
            Autowaveconnection = nil
            waveCooldown = false
        end
    end
end
})

MainTab:AddButton({ Name = "Auto collect teddy bears", Debounce = 0.5, Callback = function()
    while true do
    task.wait(1)
    for i, v in ipairs(workspace.Plots.Red.Collectibles:GetDescendants()) do
        if v.ClassName == "TouchTransmitter" then
            firetouchinterest(v.Parent, hrp, 0)
        end
    end

    for i, v in ipairs(workspace.Plots.Blue.Collectibles:GetDescendants()) do
        if v.ClassName == "TouchTransmitter" then
            firetouchinterest(v.Parent, hrp, 0)
        end
    end

    for i, v in ipairs(workspace.Plots.Green.Collectibles:GetDescendants()) do
        if v.ClassName == "TouchTransmitter" then
            firetouchinterest(v.Parent, hrp, 0)
        end
    end


    for i, v in ipairs(workspace.Plots.Yellow.Collectibles:GetDescendants()) do
        if v.ClassName == "TouchTransmitter" then
            firetouchinterest(v.Parent, hrp, 0)
        end
    end
end
end
})

MainTab:AddToggle({ Name = "Auto Load", Default = false, Callback = function(State2)
    AutoLoad = State2
    
    if AutoLoad == true then
        if not AutoLoadconnection then
            AutoLoadconnection = RunService.Heartbeat:Connect(function()
                if AutoLoad then
                    if not loadCooldown then
                        loadCooldown = true
                        AutosaveEvent:FireServer(ChoosedSave)
                        task.wait(2) -- 3 second delay between loads
                        loadCooldown = false
                    end
                end
            end)
        end
    else
        if AutoLoadconnection then
            AutoLoadconnection:Disconnect()
            AutoLoadconnection = nil
            loadCooldown = false
        end
    end
end
})
